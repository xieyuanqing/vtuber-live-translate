<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsTranslate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/page_bottom_padding">
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_radius">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView style="@style/CardTitle" android:text="@string/settings_translate_title"/>
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="@dimen/grid_4"
                    android:text="@string/settings_translate_desc"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="@string/hint_gemini_api_key"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/helper_multiple_keys">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKeys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="2"
                        android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyApiKey"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="@string/btn_apply_api_key"
                        android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewApiKeyTutorial"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:text="@string/btn_view_api_key_tutorial"
                        android:textSize="13sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvFreeQuotaHint"
                    style="@style/FieldLabel"
                    android:layout_marginTop="@dimen/grid_4"
                    android:text="@string/tv_free_quota_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteApiKey"
                        style="@style/LuminousSecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/btn_paste_key"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestTranslateConnection"
                        style="@style/LuminousSecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/btn_test_translate_connection"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvTranslateTestStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectionOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/settings_translate_btn_custom_address_expand"
                    android:minHeight="48dp"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <LinearLayout
                    android:id="@+id/connectionOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="@string/hint_api_base_url"
                        app:helperText="@string/helper_api_base_url">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBaseUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardCornerRadius="@dimen/card_radius">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTranslateAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_translate_btn_advanced_expand"
                    android:minHeight="48dp"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <LinearLayout
                    android:id="@+id/translateAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/CardTitle" android:text="@string/settings_translate_section_params"/>
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/settings_effect_next_time"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swEchoTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/settings_translate_echo_target"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvRotateVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/settings_translate_rotate_val_default"
                        android:textSize="13sp"/>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slRotate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="5"
                        android:valueFrom="120"
                        android:valueTo="580"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetTranslate"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_reset_default"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

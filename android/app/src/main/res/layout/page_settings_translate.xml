<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsTranslate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/page_bottom_padding">
        <!-- 页名由 Toolbar 承担，这里只留一句作用说明。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_translate_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>
        <!-- 主卡：填 Key → 验证，全卡只有「测试翻译连接」一个实底按钮。 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <!-- Key 行：字段 + 行内粘贴。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_gemini_api_key"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/helper_multiple_keys">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etApiKeys"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="2"
                            android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteApiKey"
                        style="@style/FieldActionButton"
                        android:layout_width="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginStart="@dimen/space_8"
                        android:minHeight="40dp"
                        android:text="@string/btn_paste_key"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewApiKeyTutorial"
                    style="@style/FieldLinkButton"
                    android:text="@string/btn_view_api_key_tutorial"/>
                <!-- 自检：一个小按钮 + 行内结果。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestTranslateConnection"
                        style="@style/FieldActionButton"
                        android:layout_width="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/btn_test_connection"/>
                    <TextView
                        android:id="@+id/tvTranslateTestStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:maxLines="3"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 可选项统一收进折叠卡，两行形态一致。 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_8">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectionOptions"
                    style="@style/DisclosureRow"
                    android:text="@string/settings_translate_custom_address"/>
                <LinearLayout
                    android:id="@+id/connectionOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingBottom="@dimen/space_8"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field"
                        android:hint="@string/hint_api_base_url"
                        app:helperText="@string/helper_api_base_url">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBaseUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:textSize="14sp"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTranslateAdvanced"
                    style="@style/DisclosureRow"
                    android:text="@string/settings_translate_advanced"/>
                <LinearLayout
                    android:id="@+id/translateAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingBottom="@dimen/space_8"
                    android:visibility="gone">
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_effect_next_time"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swEchoTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/settings_translate_echo_target"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvRotateVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/settings_translate_rotate_val_default"
                        android:textSize="13sp"/>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slRotate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="5"
                        android:valueFrom="120"
                        android:valueTo="580"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetTranslate"
                        style="@style/FieldLinkButton"
                        android:text="@string/btn_reset_default"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:text="@string/settings_credentials_local_note"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>

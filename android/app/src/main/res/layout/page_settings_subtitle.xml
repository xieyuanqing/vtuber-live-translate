<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsSubtitle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/page_bottom_padding">
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_radius">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView style="@style/CardTitle" android:text="悬浮窗样式"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="样式预览 · 切换底色可以看清盖在画面上的效果"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleSubtitlePreviewStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubtitlePreviewDark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="暗色画面"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubtitlePreviewLight"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="明亮画面"
                        android:textAllCaps="false"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <FrameLayout
                    android:id="@+id/subtitlePreviewStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@color/preview_stage_dark"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:id="@+id/tvSubtitlePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="字幕样式预览\n拖动下方滑杆调整字号与背景\n最多显示三行字幕"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:maxLines="3"
                        android:ellipsize="end"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/tvFontVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="字号 16sp"
                    android:textSize="13sp"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slFont"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="12"
                    android:valueTo="26"/>
                <TextView
                    android:id="@+id/tvOpacityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="背景不透明度 66%"
                    android:textSize="13sp"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="20"
                    android:valueTo="95"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_8">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="透明"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="不透明"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvLinesVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最多行数 3"
                    android:textSize="13sp"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="3"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardCornerRadius="@dimen/card_radius">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubtitleAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="高级断句参数 · 展开"
                    android:minHeight="48dp"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <LinearLayout
                    android:id="@+id/subtitleAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/CardTitle" android:text="断句节奏"/>
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="改动在下次开始翻译时生效"/>
                    <TextView
                        android:id="@+id/tvIdleVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="静默 2.5 秒转正"
                        android:textSize="13sp"/>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slIdle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="250"
                        android:valueFrom="1000"
                        android:valueTo="6000"/>
                    <TextView
                        android:id="@+id/tvMaxCharsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前行最长 42 字"
                        android:textSize="13sp"/>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slMaxChars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:valueFrom="20"
                        android:valueTo="80"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetSubtitle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恢复字幕默认设置"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsSubtitle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/page_bottom_padding">
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/card_radius">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView style="@style/CardTitle" android:text="@string/settings_subtitle_style_title"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_subtitle_style_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleSubtitlePreviewStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubtitlePreviewDark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/settings_subtitle_preview_dark"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubtitlePreviewLight"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/settings_subtitle_preview_light"
                        android:textAllCaps="false"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <FrameLayout
                    android:id="@+id/subtitlePreviewStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@color/preview_stage_dark"
                    android:padding="@dimen/space_16">
                    <TextView
                        android:id="@+id/tvSubtitlePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/settings_subtitle_preview_text"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:maxLines="3"
                        android:ellipsize="end"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/tvFontVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/settings_subtitle_font_size_default"
                    android:textSize="13sp"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slFont"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="12"
                    android:valueTo="26"/>
                <TextView
                    android:id="@+id/tvOpacityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle_opacity_default"
                    android:textSize="13sp"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="20"
                    android:valueTo="95"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_8">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_subtitle_opacity_transparent"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_subtitle_opacity_opaque"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvLinesVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle_lines_default"
                    android:textSize="13sp"/>
                <com.google.android.material.slider.Slider
                    android:id="@+id/slLines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="3"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardCornerRadius="@dimen/card_radius">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubtitleAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle_btn_advanced_expand"
                    android:minHeight="48dp"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <LinearLayout
                    android:id="@+id/subtitleAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/CardTitle" android:text="@string/settings_subtitle_section_segmentation"/>
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/settings_effect_next_time"/>
                    <TextView
                        android:id="@+id/tvIdleVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/settings_subtitle_idle_default"
                        android:textSize="13sp"/>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slIdle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="250"
                        android:valueFrom="1000"
                        android:valueTo="6000"/>
                    <TextView
                        android:id="@+id/tvMaxCharsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_subtitle_max_chars_default"
                        android:textSize="13sp"/>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slMaxChars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:valueFrom="20"
                        android:valueTo="80"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetSubtitle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_subtitle_btn_reset"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>

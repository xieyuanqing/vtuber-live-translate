<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsProfileAi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/page_bottom_padding">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary_fixed"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_history_badge"
                    android:gravity="center"
                    android:text="AI"
                    android:textColor="@color/brand"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="背景分析 AI（可选）"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="用于整理视频资料和补充背景。不配置也能使用实时翻译。"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/LuminousSectionLabel"
            android:layout_marginTop="@dimen/space_24"
            android:text="连接配置"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="API 格式"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleSecondAiFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiFormatGemini"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="Gemini 原生"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiFormatOpenAi"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="OpenAI 兼容"
                        android:textAllCaps="false"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="API Key"
                    app:endIconMode="password_toggle"
                    app:helperText="可与翻译服务使用相同 Key">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="服务地址（Base URL）"
                    app:helperText="填到域名即可，末尾多写的 /v1 会自动忽略">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="分析模型"
                    app:helperText="可直接手动输入模型 ID">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshSecondAiModels"
                    style="@style/LuminousSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="拉取模型列表"/>
                <TextView
                    android:id="@+id/tvSecondAiModelsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/LuminousSectionLabel"
            android:layout_marginTop="@dimen/space_24"
            android:text="连通性检查"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="拉到模型列表不等于选中的模型能用。这里会用当前配置真跑一次最短请求。"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSecondAi"
                    style="@style/LuminousSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="测试分析服务"/>
                <TextView
                    android:id="@+id/tvSecondAiTestStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:text="凭据仅保存在本机应用数据中"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>

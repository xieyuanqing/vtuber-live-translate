<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsProfileAi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/page_bottom_padding">
        <!-- 页名由 Toolbar 承担，这里只留一句作用说明。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_ai_card_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/service_label"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleSecondAiService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiServiceGemini"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/service_gemini"
                        android:paddingHorizontal="@dimen/grid_4"
                        android:textAllCaps="false"
                        android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiServiceZen"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/service_opencode_zen"
                        android:paddingHorizontal="@dimen/grid_4"
                        android:textAllCaps="false"
                        android:textSize="13sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiServiceCustom"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/service_custom"
                        android:paddingHorizontal="@dimen/grid_4"
                        android:textAllCaps="false"
                        android:textSize="13sp"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <!-- Zen 分支：无需凭据，只说明这是公开免费接入点。 -->
                <LinearLayout
                    android:id="@+id/containerZenInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_history_context"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/zen_info_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/zen_privacy_notice"
                        android:textColor="@color/warning"
                        android:textSize="12sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnZenDocLink"
                            style="@style/FieldLinkButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/zen_view_docs"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiSwitchService"
                            style="@style/FieldLinkButton"
                            android:text="@string/btn_switch_service"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- 自定义分支：先定接口格式，再填地址。 -->
                <LinearLayout
                    android:id="@+id/containerCustomFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_ai_format_label"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSecondAiFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiFormatGemini"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:layout_weight="1"
                            android:text="@string/settings_ai_format_gemini"
                            android:textAllCaps="false"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiFormatOpenAi"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:layout_weight="1"
                            android:text="@string/settings_ai_format_openai"
                            android:textAllCaps="false"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
                <!-- Key 行：字段 + 行内粘贴，整行随凭据需求显隐（Zen 不需要凭据）。 -->
                <LinearLayout
                    android:id="@+id/rowSecondAiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSecondAiKey"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_api_key"
                        app:endIconMode="password_toggle"
                        app:helperText="@string/helper_second_ai_key">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSecondAiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteSecondAiKey"
                        style="@style/FieldActionButton"
                        android:layout_width="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginStart="@dimen/space_8"
                        android:minHeight="40dp"
                        android:text="@string/btn_paste_key"/>
                </LinearLayout>
                <!-- Gemini 专属的两个链接：申请官方 Key、复用翻译服务已填的 Key。 -->
                <LinearLayout
                    android:id="@+id/containerGeminiActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiTutorial"
                        style="@style/FieldLinkButton"
                        android:text="@string/btn_view_api_key_tutorial"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUseTranslateKeyForSecondAi"
                        style="@style/FieldLinkButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/btn_use_translate_gemini_key"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSecondAiUrl"
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="@string/hint_base_url"
                    app:helperText="@string/helper_second_ai_url">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <!-- 模型行：右侧刷新图标拉取模型，结果就地下拉选择，不弹全屏面板。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSecondAiModel"
                        style="@style/Field"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_analysis_model"
                        app:helperText="@string/helper_second_ai_model">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSecondAiModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefreshSecondAiModels"
                        style="@style/IconActionButton"
                        android:layout_marginStart="@dimen/space_8"
                        android:contentDescription="@string/btn_fetch_models"
                        app:icon="@drawable/ic_refresh_24"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvSecondAiModelsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/grid_4"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"/>
                <!-- 自检：一个小按钮 + 行内结果，不占整行实底。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestSecondAi"
                        style="@style/FieldActionButton"
                        android:layout_width="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/btn_test_connection"/>
                    <TextView
                        android:id="@+id/tvSecondAiTestStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:maxLines="3"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:text="@string/settings_credentials_local_note"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>

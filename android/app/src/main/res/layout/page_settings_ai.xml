<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageSettingsProfileAi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/page_bottom_padding">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary_fixed"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_history_badge"
                    android:gravity="center"
                    android:text="@string/settings_ai_title"
                    android:textColor="@color/brand"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_ai_card_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/settings_ai_card_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/LuminousSectionLabel"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/settings_ai_section_connection"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/service_label"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleSecondAiService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiServiceGemini"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/service_gemini"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiServiceZen"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1.2"
                        android:text="@string/service_opencode_zen"
                        android:textAllCaps="false"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSecondAiServiceCustom"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:layout_weight="1"
                        android:text="@string/service_custom"
                        android:textAllCaps="false"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <LinearLayout
                    android:id="@+id/containerGeminiActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUseTranslateKeyForSecondAi"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/btn_use_translate_gemini_key"
                        android:textSize="13sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiApplyKey"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/btn_apply_api_key"
                            android:textSize="13sp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiTutorial"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/btn_view_api_key_tutorial"
                            android:textSize="13sp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPasteSecondAiKey"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/btn_paste_key"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/tv_free_quota_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/containerZenInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_history_context"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/zen_info_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/zen_limitation_warning"
                        android:textColor="@color/warning"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/zen_info_summary"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/zen_privacy_notice"
                        android:textColor="@color/warning"
                        android:textSize="11sp"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/zen_isolation_note"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnZenDocLink"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="@string/zen_view_docs"
                            android:textSize="12sp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiSwitchService"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:text="@string/btn_switch_service"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/containerCustomFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/settings_ai_format_label"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSecondAiFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiFormatGemini"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:layout_weight="1"
                            android:text="@string/settings_ai_format_gemini"
                            android:textAllCaps="false"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSecondAiFormatOpenAi"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touch_target"
                            android:layout_weight="1"
                            android:text="@string/settings_ai_format_openai"
                            android:textAllCaps="false"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSecondAiKey"
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="@string/hint_api_key"
                    app:endIconMode="password_toggle"
                    app:helperText="@string/helper_second_ai_key">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSecondAiUrl"
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="@string/hint_base_url"
                    app:helperText="@string/helper_second_ai_url">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSecondAiModel"
                    style="@style/Field"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="@string/hint_analysis_model"
                    app:helperText="@string/helper_second_ai_model">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSecondAiModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshSecondAiModels"
                    style="@style/LuminousSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/btn_fetch_models"/>
                <TextView
                    android:id="@+id/tvSecondAiModelsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            style="@style/LuminousSectionLabel"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/settings_ai_section_check"/>
        <com.google.android.material.card.MaterialCardView
            style="@style/LuminousCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_16">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ai_check_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSecondAi"
                    style="@style/LuminousSecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/btn_test_second_ai"/>
                <TextView
                    android:id="@+id/tvSecondAiTestStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:text="@string/settings_ai_privacy_note"
            android:textColor="@color/text_muted"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>

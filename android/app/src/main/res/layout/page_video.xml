<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageVideo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- 空闲态：滚动区 + 底部固定 CTA；根 ID 保留供整根显隐。 -->
    <LinearLayout
        android:id="@+id/videoIdleContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_margin"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <TextView style="@style/PageTitle" android:text="@string/video_title" />

                <TextView
                    style="@style/PageDesc"
                    android:text="@string/video_subtitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_language_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_8">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxBackgroundMode="none"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:endIconMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acVideoSourceLang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="none"
                            android:padding="0dp"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/btnVideoSwapLang"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="@string/symbol_swap"
                        android:textColor="@color/brand"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxBackgroundMode="none"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:endIconMode="none"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acVideoTargetLang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="none"
                            android:padding="0dp"
                            android:textColor="@color/brand"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 另一个模式正在占用录音时的说明横幅；空闲时控制器整行 GONE。 -->
                <LinearLayout
                    android:id="@+id/rowVideoBusy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_warning_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_12"
                    android:visibility="gone">

                    <View
                        android:layout_width="@dimen/status_dot_size"
                        android:layout_height="@dimen/status_dot_size"
                        android:background="@drawable/bg_warning_dot" />

                    <TextView
                        android:id="@+id/tvVideoBusyStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/video_busy_status"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVideoBusyGoOther"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/space_8"
                        android:text="@string/video_busy_go_other"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 缺权限时警告横幅；已授权时控制器整行 GONE。 -->
                <LinearLayout
                    android:id="@+id/rowOverlayPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_warning_banner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_12"
                    android:visibility="gone">

                    <View
                        android:id="@+id/viewOverlayPermissionDot"
                        android:layout_width="@dimen/status_dot_size"
                        android:layout_height="@dimen/status_dot_size"
                        android:background="@drawable/bg_warning_dot" />

                    <TextView
                        android:id="@+id/tvOverlayPermissionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/overlay_permission_unauthorized"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOverlayPermissionSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/space_8"
                        android:text="@string/btn_go_settings"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 场景行 + 横滑 chips -->
                <LinearLayout
                    android:id="@+id/cardVideoPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/LuminousSectionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_scene" />

                        <TextView
                            android:id="@+id/btnVideoOpenPlanLibrary"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/space_8"
                            android:text="@string/btn_scene_library_entry"
                            android:textColor="@color/brand"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvVideoPlanSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/grid_4"
                        android:text="@string/video_plan_summary_default"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCurrentProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupVideoHomeScenes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/space_8"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 视频背景：默认折叠 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/LuminousCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <LinearLayout
                            android:id="@+id/rowVideoSessionContextToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvVideoSessionContextHeader"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/video_session_context_header"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvVideoSessionContextSummary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/grid_4"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnVideoClearSessionContext"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:paddingHorizontal="@dimen/space_8"
                                android:text="@string/btn_clear"
                                android:textColor="@color/brand"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/videoSessionContextBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Field"
                                android:layout_marginTop="@dimen/space_8"
                                android:hint="@string/hint_video_url"
                                app:helperText="@string/helper_video_url">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etVideoSessionUrl"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textUri"
                                    android:maxLines="2" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Field"
                                android:layout_marginTop="@dimen/space_12"
                                android:hint="@string/hint_session_context"
                                app:helperText="@string/helper_video_context">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etVideoSessionContext"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="top"
                                    android:inputType="textCapSentences|textMultiLine"
                                    android:minLines="3"
                                    android:maxLines="7" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVideoAnalyzeContext"
                                style="@style/LuminousSecondaryButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="@dimen/space_12"
                                android:text="@string/video_btn_ai_fetch_context" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:text="@string/video_ai_fetch_tip"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvVideoAnalyzeStatus"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text=""
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btnVideoAnalyzeConfigure"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:gravity="center"
                                    android:paddingHorizontal="@dimen/space_8"
                                    android:text="@string/btn_go_configure"
                                    android:textColor="@color/brand"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btnVideoUndoAnalysis"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:gravity="center"
                                    android:paddingHorizontal="@dimen/space_8"
                                    android:text="@string/btn_undo_replacement"
                                    android:textColor="@color/brand"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- AI 结果先落在这里，不直接覆盖用户手写的资料。 -->
                            <LinearLayout
                                android:id="@+id/videoAnalyzePreview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:background="@drawable/bg_history_context"
                                android:orientation="vertical"
                                android:padding="@dimen/space_12"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/interp_ai_preview_banner"
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvVideoAnalyzePreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_12"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnVideoApplyAnalysis"
                                        style="@style/LuminousSecondaryButton"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_marginEnd="@dimen/space_8"
                                        android:layout_weight="1"
                                        android:text="@string/btn_apply_analysis" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnVideoDiscardAnalysis"
                                        style="@style/Widget.Material3.Button.TextButton"
                                        android:layout_width="0dp"
                                        android:layout_height="48dp"
                                        android:layout_weight="1"
                                        android:text="@string/btn_discard_analysis" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            style="@style/LuminousPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_action_height"
            android:layout_marginHorizontal="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_16"
            android:text="@string/video_btn_start"
            app:icon="@drawable/ic_nav_video_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_8"
            app:iconTint="@color/brand_on" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/videoRunningContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_16"
        android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/PageTitle" android:text="@string/video_running_badge" />

                <TextView
                    android:id="@+id/tvVideoElapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="@string/default_time_zero"
                    android:textColor="@color/brand"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/LuminousCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewVideoRunningStatusDot"
                            android:layout_width="@dimen/status_dot_size"
                            android:layout_height="@dimen/status_dot_size"
                            android:background="@drawable/bg_success_dot" />

                        <TextView
                            android:id="@+id/tvHeroStatus"
                            style="@style/LuminousStatusText"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/status_preparing_connection" />

                        <TextView
                            android:id="@+id/tvAudioLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="@string/default_percentage_zero"
                            android:textColor="@color/brand"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroSubStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/video_sub_status_running"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/pbAudio"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/space_12"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="@color/surface_high"
                        android:progressTint="@color/brand" />

                    <TextView
                        android:id="@+id/tvVideoRunningMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/video_running_meta_default"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <!-- 长时间收不到声音时的排查提示；正常静音不会触发。 -->
                    <TextView
                        android:id="@+id/tvVideoSilenceTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textColor="@color/warning"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/videoSubtitleScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <com.google.android.material.card.MaterialCardView
                style="@style/LuminousCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView style="@style/CardTitle" android:text="@string/label_live_subtitles" />

                    <LinearLayout
                        android:id="@+id/videoConfirmedList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_transcript_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvVideoTargetLanguageLabel"
                                style="@style/FieldLabel"
                                android:layout_marginTop="0dp"
                                android:text="@string/target_lang_chinese" />

                            <TextView
                                android:id="@+id/tvLiveZh"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/grid_4"
                                android:minHeight="56dp"
                                android:text="@string/subtitle_waiting_translation"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLiveJa"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:minHeight="32dp"
                                android:text="@string/subtitle_waiting_speech"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_subtitles_auto_saved"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnVideoOpenHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/space_8"
                            android:text="@string/btn_view_current_session_record"
                            android:textColor="@color/brand"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVideoScrollLatest"
                style="@style/LuminousSecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/btn_scroll_latest"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_down_24"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/grid_4"
                app:iconTint="@color/brand" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVideoPause"
                style="@style/LuminousSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/primary_action_height"
                android:layout_marginEnd="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/btn_pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVideoStop"
                style="@style/LuminousDangerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/primary_action_height"
                android:layout_weight="1"
                android:text="@string/video_btn_stop"
                app:icon="@drawable/ic_stop_white_24"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_8" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
